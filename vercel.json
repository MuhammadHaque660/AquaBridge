{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix app ci",
  "buildCommand": "node tools/build-site.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/prototype", "destination": "/prototype/index.html" },
    { "source": "/prototype/:path*", "destination": "/prototype/index.html" }
  ]
}
